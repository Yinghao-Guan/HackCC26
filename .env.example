# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Only this example file is meant to be committed.

# The AI that reads the board. Gemini is asked first; if it fails, Claude is asked instead.
# A key that is left empty is skipped, so one of the two is enough.
# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: AI_PROVIDER=claude asks Claude first. GEMINI_MODEL pins a Gemini model
# (default gemini-flash-latest).
# AI_PROVIDER=claude
# GEMINI_MODEL=gemini-3.5-flash

# Optional. The camera service's event bus (cv/README.md). Defaults to ws://127.0.0.1:8765/ws;
# set it to "off" when you are not using the camera.
# NEXT_PUBLIC_CV_BUS_URL=off
